<Window x:Class="ArchiveViewer.Dialogs.TagManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="タグ管理" Width="780" Height="540" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBg}" ResizeMode="NoResize" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="閉じる" Width="90" Padding="4" Click="BtnClose_Click"
                    Background="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: 大カテゴリ -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="大カテゴリ" Foreground="{DynamicResource ThemeText}"
                           FontFamily="Yu Gothic UI" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="新規" Width="55" Padding="4" Margin="0,0,4,0" Click="BtnNewMajor_Click"
                            Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                    <Button Content="名前変更" Width="70" Padding="4" Margin="0,0,4,0" Click="BtnRenameMajor_Click"
                            Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                    <Button Content="色" Width="40" Padding="4" Margin="0,0,4,0" Click="BtnColorMajor_Click"
                            Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                    <Button Content="削除" Width="55" Padding="4" Click="BtnDeleteMajor_Click"
                            Background="#7f1d1d" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                </StackPanel>
                <TextBox x:Name="TxtQuickAddMajor" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                         Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"
                         CaretBrush="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="13" Padding="4"
                         KeyDown="TxtQuickAddMajor_KeyDown"
                         ToolTip="カテゴリ名を入力してEnterで末尾に追加（連続入力できます）"/>
                <ListBox x:Name="MajorList" Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}"
                         BorderBrush="{DynamicResource ThemeBorder}" FontFamily="Yu Gothic UI" FontSize="13"
                         SelectionChanged="MajorList_SelectionChanged"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="ListItem_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ListItem_PreviewMouseMove"
                         Drop="MajorList_Drop"/>
            </DockPanel>

            <!-- Column 2: 中カテゴリ -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="中カテゴリ" Foreground="{DynamicResource ThemeText}"
                           FontFamily="Yu Gothic UI" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="新規" Width="55" Padding="4" Margin="0,0,4,0" Click="BtnNewMinor_Click"
                            Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                    <Button Content="名前変更" Width="70" Padding="4" Margin="0,0,4,0" Click="BtnRenameMinor_Click"
                            Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                    <Button Content="色" Width="40" Padding="4" Margin="0,0,4,0" Click="BtnColorMinor_Click"
                            Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                    <Button Content="削除" Width="55" Padding="4" Click="BtnDeleteMinor_Click"
                            Background="#7f1d1d" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="⭐ 必須の切り替え" Padding="4" Margin="0,0,0,4" Click="BtnToggleMinorRequired_Click"
                        Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                <TextBox x:Name="TxtQuickAddMinor" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                         Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"
                         CaretBrush="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="13" Padding="4"
                         KeyDown="TxtQuickAddMinor_KeyDown"
                         ToolTip="カテゴリ名を入力してEnterで末尾に追加（連続入力できます）"/>
                <ListBox x:Name="MinorList" Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}"
                         BorderBrush="{DynamicResource ThemeBorder}" FontFamily="Yu Gothic UI" FontSize="13"
                         SelectionChanged="MinorList_SelectionChanged"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="ListItem_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ListItem_PreviewMouseMove"
                         Drop="MinorList_Drop"/>
            </DockPanel>

            <!-- Column 3: タグ -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="タグ" Foreground="{DynamicResource ThemeText}"
                           FontFamily="Yu Gothic UI" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="新規" Width="55" Padding="4" Margin="0,0,4,0" Click="BtnNewTag_Click"
                            Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                    <Button Content="名前変更" Width="70" Padding="4" Margin="0,0,4,0" Click="BtnRenameTag_Click"
                            Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                    <Button Content="色" Width="40" Padding="4" Margin="0,0,4,0" Click="BtnColorTag_Click"
                            Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                    <Button Content="削除" Width="55" Padding="4" Click="BtnDeleteTag_Click"
                            Background="#7f1d1d" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                </StackPanel>
                <TextBox x:Name="TxtQuickAddTag" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                         Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"
                         CaretBrush="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="13" Padding="4"
                         KeyDown="TxtQuickAddTag_KeyDown"
                         ToolTip="タグ名を入力してEnterで末尾に追加（連続入力できます）"/>
                <ListBox x:Name="TagList" Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}"
                         BorderBrush="{DynamicResource ThemeBorder}" FontFamily="Yu Gothic UI" FontSize="13"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="ListItem_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ListItem_PreviewMouseMove"
                         Drop="TagList_Drop"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
