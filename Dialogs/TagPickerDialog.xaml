<Window x:Class="ArchiveViewer.Dialogs.TagPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="タグを選択" Width="960" Height="680" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBg}" ResizeMode="NoResize" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOk" Content="OK" Width="80" Padding="4" Margin="0,0,8,0" Click="BtnOk_Click"
                    Background="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
            <Button Content="キャンセル" Width="80" Padding="4" Click="BtnCancel_Click"
                    Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
        </StackPanel>

        <TextBlock x:Name="TxtRequiredWarning" DockPanel.Dock="Bottom" Foreground="#ef4444" FontFamily="Yu Gothic UI"
                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Right" Visibility="Collapsed"/>

        <Button DockPanel.Dock="Bottom" Content="🏷 タグ管理（カテゴリ分けして新規作成）" Padding="4" Margin="0,8,0,0" Click="BtnOpenTagManager_Click"
                Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>

        <TextBox x:Name="TxtFilter" DockPanel.Dock="Top" Margin="0,0,0,12"
                 Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"
                 CaretBrush="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="14" Padding="6,4"
                 TextChanged="TxtFilter_TextChanged"
                 ToolTip="タグ名・カテゴリ名で絞り込み"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="ColumnsPanel" Orientation="Horizontal"/>
        </ScrollViewer>
    </DockPanel>
</Window>
