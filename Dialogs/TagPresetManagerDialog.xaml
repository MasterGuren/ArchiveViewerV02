<Window x:Class="ArchiveViewer.Dialogs.TagPresetManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="タグプリセット管理" Width="620" Height="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBg}" ResizeMode="NoResize" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="閉じる" Width="90" Padding="4" Click="BtnClose_Click"
                    Background="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: プリセット一覧（ドラッグ&ドロップで並べ替え） -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="プリセット" Foreground="{DynamicResource ThemeText}"
                           FontFamily="Yu Gothic UI" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="名前変更" Width="70" Padding="4" Margin="0,0,4,0" Click="BtnRename_Click"
                            Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                    <Button Content="タグを編集..." Width="90" Padding="4" Margin="0,0,4,0" Click="BtnEditTags_Click"
                            Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                    <Button Content="削除" Width="55" Padding="4" Click="BtnDelete_Click"
                            Background="#7f1d1d" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                </StackPanel>
                <ListBox x:Name="PresetList" Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}"
                         BorderBrush="{DynamicResource ThemeBorder}" FontFamily="Yu Gothic UI" FontSize="13"
                         SelectionChanged="PresetList_SelectionChanged"
                         MouseDoubleClick="PresetList_MouseDoubleClick"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="PresetList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="PresetList_PreviewMouseMove"
                         Drop="PresetList_Drop"
                         ToolTip="ドラッグ&amp;ドロップで並べ替え／ダブルクリックでタグを編集"/>
            </DockPanel>

            <!-- Column 2: 選択中プリセットのタグ -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="含まれるタグ" Foreground="{DynamicResource ThemeText}"
                           FontFamily="Yu Gothic UI" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                <ListBox x:Name="TagList" Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}"
                         BorderBrush="{DynamicResource ThemeBorder}" FontFamily="Yu Gothic UI" FontSize="13"
                         Focusable="False"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
