<Window x:Class="ArchiveViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="NU9N &lt;Next Unified 9-grade Notation&gt;" Icon="app.ico" Width="1400" Height="850" MinWidth="800" MinHeight="600"
        Background="{DynamicResource ThemeBg}" WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown" PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewMouseUp="Window_PreviewMouseUp"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing" Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemePanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemePanelText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontFamily" Value="Yu Gothic UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeHoverText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/>
        </Style>

        <Style x:Key="ModeButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ThemePanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemePanelText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontFamily" Value="Yu Gothic UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeHoverText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeText}"/>
            <Setter Property="FontFamily" Value="Yu Gothic UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- タグ閲覧/タグ動画の右サイドバー・ファイル一覧の行の共通スタイル。選択色に加えて偶数/奇数行で背景を変え、境目を分かりやすくする。 -->
        <Style x:Key="TagListItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Path}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="border" Property="Background" Value="#40808080"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- タグ閲覧/タグ動画の右サイドバー・ファイル一覧の行テンプレート。タグ部分の折り返しあり/なしを切り替えられるよう2種類用意する。 -->
        <DataTemplate x:Key="TagListItemTemplateWrap">
            <StackPanel>
                <TextBlock Text="{Binding FileName}" FontFamily="Yu Gothic UI" FontSize="12"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <TextBlock Text="{Binding FileSizeText}"
                               Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="11"/>
                    <TextBlock Text="{Binding WorkTitle}" Visibility="{Binding WorkTitleVisibility}"
                               Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="11" Margin="6,0,0,0"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,2,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}" CornerRadius="6" Padding="4,1" Margin="0,0,3,3">
                                <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontFamily="Yu Gothic UI" FontSize="9"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TagListItemTemplateNoWrap">
            <StackPanel>
                <TextBlock Text="{Binding FileName}" FontFamily="Yu Gothic UI" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <TextBlock Text="{Binding FileSizeText}"
                               Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="11"/>
                    <TextBlock Text="{Binding WorkTitle}" Visibility="{Binding WorkTitleVisibility}"
                               Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="11" Margin="6,0,0,0"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,2,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}" CornerRadius="6" Padding="4,1" Margin="0,0,3,3">
                                <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontFamily="Yu Gothic UI" FontSize="9"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="img/logo_full4.png" Height="28" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.8"/>
                    <ToggleButton x:Name="BtnRating" Content="閲覧" Style="{StaticResource ModeButton}" Click="BtnRating_Click" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="BtnExtract" Content="抽出" Style="{StaticResource ModeButton}" Click="BtnExtract_Click" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="BtnVideo" Content="動画" Style="{StaticResource ModeButton}" Click="BtnVideo_Click" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="BtnImage" Content="画像" Style="{StaticResource ModeButton}" Click="BtnImage_Click" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="BtnTag" Content="タグ閲覧" Style="{StaticResource ModeButton}" Click="BtnTag_Click" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="BtnTagVideo" Content="タグ動画" Style="{StaticResource ModeButton}" Click="BtnTagVideo_Click" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="BtnBrowse" Content="旧閲覧" Style="{StaticResource ModeButton}" Click="BtnBrowse_Click" Margin="0,0,12,0" Visibility="Collapsed"/>

                    <Border Width="1" Background="{DynamicResource ThemeBorder}" Margin="0,8"/>

                    <ToggleButton x:Name="BtnSortName" Content="名前順" Style="{StaticResource ModeButton}" Click="BtnSortName_Click" IsChecked="True" Margin="12,0,2,0"/>
                    <ToggleButton x:Name="BtnSortDate" Content="更新日順" Style="{StaticResource ModeButton}" Click="BtnSortDate_Click" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="BtnSortCreated" Content="作成日順" Style="{StaticResource ModeButton}" Click="BtnSortCreated_Click" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="BtnSortSize" Content="サイズ順" Style="{StaticResource ModeButton}" Click="BtnSortSize_Click" Margin="0,0,2,0"/>
                    <ToggleButton x:Name="BtnSortRandom" Content="ランダム" Style="{StaticResource ModeButton}" Click="BtnSortRandom_Click" Margin="0,0,12,0"/>

                    <Border Width="1" Background="{DynamicResource ThemeBorder}" Margin="0,8"/>

                    <ToggleButton x:Name="BtnPortrait" Content="縦" Style="{StaticResource ModeButton}" Click="BtnPortrait_Click" IsChecked="True" Margin="12,0,2,0"/>
                    <ToggleButton x:Name="BtnLandscape" Content="横" Style="{StaticResource ModeButton}" Click="BtnLandscape_Click" Margin="0,0,12,0"/>

                    <Border Width="1" Background="{DynamicResource ThemeBorder}" Margin="0,8"/>

                    <Button x:Name="BtnOpen" Content="📁 開く" Style="{StaticResource DarkButton}" Click="BtnOpen_Click" Margin="12,0,4,0" FontFamily="Segoe UI Emoji, Yu Gothic UI"/>

                    <Button x:Name="BtnExtractRange" Content="✂️ 範囲を抽出" Style="{StaticResource AccentButton}"
                            Click="BtnExtractRange_Click" Visibility="Collapsed" Margin="4,0,2,0"/>
                    <Button x:Name="BtnClearSelection" Content="🗑 選択解除" Style="{StaticResource DarkButton}"
                            Click="BtnClearSelection_Click" Visibility="Collapsed" Margin="2,0,0,0"/>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 前ファイル名（右寄せ、余白に収まる） -->
                    <TextBlock x:Name="TxtPrevFile" Grid.Column="0" Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="14"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- ⏮ ◀ ボタン（中央固定） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnFirst" Content="⏮" Style="{StaticResource DarkButton}" Click="BtnFirst_Click"
                                Padding="6,4" Margin="0,0,2,0" ToolTip="先頭へ"/>
                        <Button x:Name="BtnPrev" Content="◀" Style="{StaticResource DarkButton}" Click="BtnPrev_Click"
                                Padding="6,4"/>
                    </StackPanel>
                    <!-- 現在ファイル名＋位置（中央固定幅） -->
                    <Border Grid.Column="2" Width="360" Margin="4,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCurrentFile" Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="14"
                                       VerticalAlignment="Center" FontWeight="Bold"
                                       MaxWidth="290" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtFilePosition" Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="13"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- ▶ ⏭ ボタン（中央固定） -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="BtnNext" Content="▶" Style="{StaticResource DarkButton}" Click="BtnNext_Click"
                                Padding="6,4" Margin="0,0,2,0"/>
                        <Button x:Name="BtnLast" Content="⏭" Style="{StaticResource DarkButton}" Click="BtnLast_Click"
                                Padding="6,4" ToolTip="末尾へ"/>
                    </StackPanel>
                    <!-- 次ファイル名（左寄せ、余白に収まる） -->
                    <TextBlock x:Name="TxtNextFile" Grid.Column="4" Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="14"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- タグDB切り替え（画面右端固定） -->
                <Button x:Name="BtnTagDbMode" Grid.Column="2" Style="{StaticResource DarkButton}"
                        Click="BtnTagDbMode_Click" VerticalAlignment="Center" Margin="8,0,0,0"
                        FontWeight="Bold" ToolTip="タグDBの切り替え（デモ／本番）。次回起動時も保持されます。"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftSidebarCol" Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightSidebarCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel x:Name="LeftSidebarPinned" DockPanel.Dock="Top" Margin="12,12,12,0" Visibility="Collapsed"/>
                    <ScrollViewer x:Name="SidebarScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="LeftSidebar" Margin="12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- MAIN AREA -->
            <Grid Grid.Column="1">
                <ScrollViewer x:Name="GridScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource ThemeBg}">
                    <WrapPanel x:Name="ThumbnailGrid" Margin="8"/>
                </ScrollViewer>

                <StackPanel x:Name="EmptyMessage" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Visible">
                    <Image Source="img/logo_full4.png" Height="120" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.8"/>
                    <TextBlock Text="アーカイブをドロップまたは「開く」で選択" Foreground="{DynamicResource ThemeSubtext}"
                               FontFamily="Yu Gothic UI" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <Border x:Name="ProgressOverlay" Background="{DynamicResource ThemeBgOverlay}" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar x:Name="LoadProgress" Width="300" Height="20" Minimum="0" Maximum="100"
                                     Foreground="{DynamicResource ThemeAccent}" Background="{DynamicResource ThemePanel}"/>
                        <TextBlock x:Name="ProgressText" Text="読み込み中..." Foreground="{DynamicResource ThemeText}"
                                   FontFamily="Yu Gothic UI" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Image Viewer Overlay -->
                <Grid x:Name="ViewerOverlay" Visibility="Collapsed" Background="{DynamicResource ThemeBg}"
                      MouseLeftButtonDown="ViewerOverlay_MouseLeftButtonDown"
                      MouseMove="ViewerOverlay_MouseMove">
                    <Image x:Name="ViewerImage" Stretch="Uniform" Margin="8"/>
                    <Border x:Name="ViewerBottomBar" VerticalAlignment="Bottom" Height="96"
                            Background="{DynamicResource ThemePanelOverlay}" Opacity="0" IsHitTestVisible="True"
                            MouseEnter="ViewerBottomBar_MouseEnter" MouseLeave="ViewerBottomBar_MouseLeave">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <Slider x:Name="ViewerSlider" Minimum="0" Maximum="100"
                                    ValueChanged="ViewerSlider_ValueChanged" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ViewerInfo" Foreground="{DynamicResource ThemeSubtext}"
                                       FontFamily="Yu Gothic UI" FontSize="13" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="フィルタ:" Foreground="{DynamicResource ThemeSubtext}"
                                           FontFamily="Yu Gothic UI" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <RadioButton x:Name="RbScaleDefault" Content="デフォルト" GroupName="ImageScale"
                                             IsChecked="True" Click="ImageScaleMode_Click" Tag="Default"
                                             Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"
                                             VerticalAlignment="Center" Margin="2,0"/>
                                <RadioButton x:Name="RbScaleSmooth" Content="スムース" GroupName="ImageScale"
                                             Click="ImageScaleMode_Click" Tag="Fant"
                                             Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"
                                             VerticalAlignment="Center" Margin="2,0"/>
                                <RadioButton x:Name="RbScaleHQ" Content="高品質" GroupName="ImageScale"
                                             Click="ImageScaleMode_Click" Tag="HighQuality"
                                             Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"
                                             VerticalAlignment="Center" Margin="2,0"/>
                                <RadioButton x:Name="RbScaleNN" Content="ニアレスト" GroupName="ImageScale"
                                             Click="ImageScaleMode_Click" Tag="NearestNeighbor"
                                             Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"
                                             VerticalAlignment="Center" Margin="2,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Video Player Overlay -->
                <Grid x:Name="VideoOverlay" Visibility="Collapsed" Background="{DynamicResource ThemeBg}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="VideoViewHost" Grid.Row="0" Background="Black"/>

                    <Border x:Name="VideoControlsBar" Grid.Row="1" Background="{DynamicResource ThemePanel}" Padding="4,2">
                        <StackPanel>
                            <!-- Row 1: Seek bar + time -->
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock x:Name="VideoTimeText" DockPanel.Dock="Right" Foreground="{DynamicResource ThemeSubtext}"
                                           FontFamily="Yu Gothic UI" FontSize="12" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Text="00:00 / 00:00"/>
                                <Canvas x:Name="SeekBarCanvas" Height="16" Background="Transparent"
                                        MouseLeftButtonDown="SeekBar_MouseDown" MouseMove="SeekBar_MouseMove"
                                        MouseLeftButtonUp="SeekBar_MouseUp"/>
                            </DockPanel>
                            <!-- Row 2: Controls -->
                            <DockPanel>
                                <Button Content="✕" Style="{StaticResource DarkButton}" DockPanel.Dock="Right"
                                        Click="BtnCloseVideo_Click" Padding="6,1" Margin="4,0,0,0" ToolTip="閉じる"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="⏮" Style="{StaticResource AccentButton}" Click="BtnVideoPrev_Click" Padding="6,1" Margin="0,0,2,0" ToolTip="前の動画" FontSize="13"/>
                                    <Button Content="⏪10m" Style="{StaticResource DarkButton}" Click="VideoSkip_Click" Tag="-600" Padding="3,1" Margin="1,0" FontSize="11"/>
                                    <Button Content="⏪3m" Style="{StaticResource DarkButton}" Click="VideoSkip_Click" Tag="-180" Padding="3,1" Margin="1,0" FontSize="11"/>
                                    <Button Content="⏪30s" Style="{StaticResource DarkButton}" Click="VideoSkip_Click" Tag="-30" Padding="3,1" Margin="1,0" FontSize="11"/>
                                    <Button Content="⏪10s" Style="{StaticResource DarkButton}" Click="VideoSkip_Click" Tag="-10" Padding="3,1" Margin="1,0" FontSize="11"/>
                                    <Button x:Name="BtnPlayPause" Content="▶" Style="{StaticResource AccentButton}" Click="BtnPlayPause_Click" Padding="10,1" Margin="3,0" FontSize="13"/>
                                    <Button Content="10s⏩" Style="{StaticResource DarkButton}" Click="VideoSkip_Click" Tag="10" Padding="3,1" Margin="1,0" FontSize="11"/>
                                    <Button Content="30s⏩" Style="{StaticResource DarkButton}" Click="VideoSkip_Click" Tag="30" Padding="3,1" Margin="1,0" FontSize="11"/>
                                    <Button Content="3m⏩" Style="{StaticResource DarkButton}" Click="VideoSkip_Click" Tag="180" Padding="3,1" Margin="1,0" FontSize="11"/>
                                    <Button Content="10m⏩" Style="{StaticResource DarkButton}" Click="VideoSkip_Click" Tag="600" Padding="3,1" Margin="1,0" FontSize="11"/>
                                    <Button Content="⏭" Style="{StaticResource AccentButton}" Click="BtnVideoNext_Click" Padding="6,1" Margin="2,0,6,0" ToolTip="次の動画" FontSize="13"/>

                                    <Button x:Name="BtnMute" Content="🔊" Style="{StaticResource DarkButton}" Click="BtnMute_Click"
                                            Padding="3,1" Margin="0,0,2,0" FontFamily="Segoe UI Emoji" FontSize="12" ToolTip="ミュート切替"/>
                                    <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="100"
                                            Value="80" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center"
                                            PreviewMouseWheel="VolumeSlider_MouseWheel"/>
                                    <TextBlock x:Name="VolumeText" Text="80%" Foreground="{DynamicResource ThemeSubtext}"
                                               FontFamily="Yu Gothic UI" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"/>

                                    <TextBlock Text="終了:" Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,2,0"/>
                                    <RadioButton x:Name="RbEndStop" Content="停止" GroupName="VideoEnd" IsChecked="True"
                                                 Click="VideoEndAction_Click" Tag="stop" VerticalAlignment="Center" Margin="2,0"
                                                 Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"/>
                                    <RadioButton x:Name="RbEndLoop" Content="リピート" GroupName="VideoEnd"
                                                 Click="VideoEndAction_Click" Tag="loop" VerticalAlignment="Center" Margin="2,0"
                                                 Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"/>
                                    <RadioButton x:Name="RbEndNext" Content="次の動画" GroupName="VideoEnd"
                                                 Click="VideoEndAction_Click" Tag="next" VerticalAlignment="Center" Margin="2,0"
                                                 Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"/>

                                    <TextBlock Text="スクロール:" Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,2,0"/>
                                    <RadioButton x:Name="RbScroll10s" Content="10s" GroupName="VideoScroll"
                                                 Click="VideoScrollAmount_Click" Tag="10" VerticalAlignment="Center" Margin="2,0"
                                                 Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"/>
                                    <RadioButton x:Name="RbScroll30s" Content="30s" GroupName="VideoScroll"
                                                 Click="VideoScrollAmount_Click" Tag="30" VerticalAlignment="Center" Margin="2,0"
                                                 Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"/>
                                    <RadioButton x:Name="RbScroll1m" Content="1m" GroupName="VideoScroll"
                                                 Click="VideoScrollAmount_Click" Tag="60" VerticalAlignment="Center" Margin="2,0"
                                                 Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"/>
                                    <RadioButton x:Name="RbScroll5m" Content="5m" GroupName="VideoScroll"
                                                 Click="VideoScrollAmount_Click" Tag="300" VerticalAlignment="Center" Margin="2,0"
                                                 Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"/>
                                    <RadioButton x:Name="RbScroll1p" Content="1%" GroupName="VideoScroll"
                                                 Click="VideoScrollAmount_Click" Tag="percent1" VerticalAlignment="Center" Margin="2,0"
                                                 Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"/>
                                    <RadioButton x:Name="RbScroll5p" Content="5%" GroupName="VideoScroll"
                                                 Click="VideoScrollAmount_Click" Tag="percent5" VerticalAlignment="Center" Margin="2,0"
                                                 Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"/>
                                    <RadioButton x:Name="RbScroll10p" Content="10%" GroupName="VideoScroll"
                                                 Click="VideoScrollAmount_Click" Tag="percent10" VerticalAlignment="Center" Margin="2,0"
                                                 Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="11"/>

                                    <TextBox x:Name="VideoFileName" IsReadOnly="True" Background="Transparent"
                                             Foreground="{DynamicResource ThemeSubtext}" BorderThickness="0"
                                             FontFamily="Yu Gothic UI" FontSize="11" VerticalAlignment="Center"
                                             Margin="10,0,0,0" MaxWidth="300" TextWrapping="NoWrap" Cursor="IBeam"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- RIGHT SIDEBAR (Extract mode / Tag mode) -->
            <Border x:Name="RightSidebar" Grid.Column="2" Background="{DynamicResource ThemePanel}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid>
                    <DockPanel x:Name="ExtractRightSidebarContent" Margin="12">
                        <Button DockPanel.Dock="Top" Content="選択範囲をリストに追加"
                                Style="{StaticResource AccentButton}" Click="BtnAddToExtractList_Click" Margin="0,0,0,4"/>
                        <Button x:Name="BtnClearExtractList" DockPanel.Dock="Top" Content="リストクリア"
                                Click="BtnClearExtractList_Click" Margin="0,0,0,8"
                                Background="Transparent" Foreground="{DynamicResource ThemeSubtext}"
                                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                FontSize="12" Padding="4,2" IsEnabled="False"/>
                        <Button DockPanel.Dock="Bottom" Content="抽出実行"
                                Style="{StaticResource AccentButton}" Click="BtnExecuteExtract_Click" Margin="0,8,0,0"/>
                        <ScrollViewer x:Name="RightSidebarScroller" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ExtractListPanel"/>
                        </ScrollViewer>
                    </DockPanel>

                    <DockPanel x:Name="TagRightSidebarContent" Margin="12" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Text="検索" Foreground="{DynamicResource ThemeText}"
                                   FontFamily="Yu Gothic UI" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="タグ" Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="12" Margin="0,0,0,2"/>
                            <StackPanel x:Name="TagSearchChipsPanel" Margin="0,0,0,4"/>
                            <Button Content="+ タグで絞り込む" Click="BtnTagSearchPickTags_Click" Padding="4" Margin="0,0,0,6"
                                    Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="RbTagSearchOr" Content="OR（いずれか）" GroupName="TagSearchMode" IsChecked="True"
                                             Checked="TagSearchRadio_Checked"
                                             Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12" Margin="0,0,12,0"/>
                                <RadioButton x:Name="RbTagSearchAnd" Content="AND（すべて）" GroupName="TagSearchMode"
                                             Checked="TagSearchRadio_Checked"
                                             Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="文字列（ファイル名／作品名）" Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="12" Margin="0,0,0,2"/>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="×" Width="24" Padding="0" Margin="4,0,0,0" Click="BtnClearTagSearchText_Click"
                                        Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                                <TextBox x:Name="TxtTagSearchText" Style="{StaticResource DarkTextBox}" KeyDown="TxtTagSearchText_KeyDown" LostFocus="TxtTagSearchText_LostFocus"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <CheckBox x:Name="ChkSearchNoTags" Content="タグ未設定" Click="TagFilterCheckbox_Click"
                                          Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12" Margin="0,0,12,0"/>
                                <CheckBox x:Name="ChkSearchHasTags" Content="タグ設定済み" Click="TagFilterCheckbox_Click"
                                          Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="ChkSearchNoTitle" Content="名前未設定" Click="TagFilterCheckbox_Click"
                                          Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12" Margin="0,0,12,0"/>
                                <CheckBox x:Name="ChkSearchHasTitle" Content="名前設定済み" Click="TagFilterCheckbox_Click"
                                          Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12"/>
                            </StackPanel>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🔍 検索実行" Click="BtnExecuteTagSearch_Click" Padding="4"
                                        Style="{StaticResource AccentButton}"/>
                                <Button Grid.Column="1" Content="🔄 リセット" Click="BtnResetTagSearch_Click" Padding="6,4" Margin="6,0,0,0"
                                        Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                            </Grid>
                        </StackPanel>

                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,0,0,8"/>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="▶ 先頭を開く" Click="BtnOpenTopTagFile_Click" Padding="4,2" FontSize="11"
                                    Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                            <Button x:Name="BtnToggleTagWrap" DockPanel.Dock="Right" Click="BtnToggleTagWrap_Click" Padding="4,2" FontSize="11" Margin="0,0,4,0"
                                    Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                            <TextBlock x:Name="TxtTagFileListHeader" Text="ファイル一覧" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="14"
                                       FontWeight="Bold"/>
                        </DockPanel>
                        <ListBox x:Name="TagFileListPanel" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ItemTemplate="{StaticResource TagListItemTemplateWrap}"
                                 ItemContainerStyle="{StaticResource TagListItemContainerStyle}"
                                 AlternationCount="2"
                                 SelectionChanged="TagFileListPanel_SelectionChanged"/>
                    </DockPanel>

                    <DockPanel x:Name="TagVideoRightSidebarContent" Margin="12" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Text="検索" Foreground="{DynamicResource ThemeText}"
                                   FontFamily="Yu Gothic UI" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="タグ" Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="12" Margin="0,0,0,2"/>
                            <StackPanel x:Name="TagVideoSearchChipsPanel" Margin="0,0,0,4"/>
                            <Button Content="+ タグで絞り込む" Click="BtnTagVideoSearchPickTags_Click" Padding="4" Margin="0,0,0,6"
                                    Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="RbTagVideoSearchOr" Content="OR（いずれか）" GroupName="TagVideoSearchMode" IsChecked="True"
                                             Checked="TagVideoSearchRadio_Checked"
                                             Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12" Margin="0,0,12,0"/>
                                <RadioButton x:Name="RbTagVideoSearchAnd" Content="AND（すべて）" GroupName="TagVideoSearchMode"
                                             Checked="TagVideoSearchRadio_Checked"
                                             Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="文字列（ファイル名／作品名）" Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="12" Margin="0,0,0,2"/>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="×" Width="24" Padding="0" Margin="4,0,0,0" Click="BtnClearTagVideoSearchText_Click"
                                        Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                                <TextBox x:Name="TxtTagVideoSearchText" Style="{StaticResource DarkTextBox}" KeyDown="TxtTagVideoSearchText_KeyDown" LostFocus="TxtTagVideoSearchText_LostFocus"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <CheckBox x:Name="ChkSearchVideoNoTags" Content="タグ未設定" Click="TagVideoFilterCheckbox_Click"
                                          Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12" Margin="0,0,12,0"/>
                                <CheckBox x:Name="ChkSearchVideoHasTags" Content="タグ設定済み" Click="TagVideoFilterCheckbox_Click"
                                          Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="ChkSearchVideoNoTitle" Content="名前未設定" Click="TagVideoFilterCheckbox_Click"
                                          Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12" Margin="0,0,12,0"/>
                                <CheckBox x:Name="ChkSearchVideoHasTitle" Content="名前設定済み" Click="TagVideoFilterCheckbox_Click"
                                          Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12"/>
                            </StackPanel>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🔍 検索実行" Click="BtnExecuteTagVideoSearch_Click" Padding="4"
                                        Style="{StaticResource AccentButton}"/>
                                <Button Grid.Column="1" Content="🔄 リセット" Click="BtnResetTagVideoSearch_Click" Padding="6,4" Margin="6,0,0,0"
                                        Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                            </Grid>
                        </StackPanel>

                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,0,0,8"/>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="▶ 先頭を開く" Click="BtnOpenTopTagVideoFile_Click" Padding="4,2" FontSize="11"
                                    Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                            <Button x:Name="BtnToggleTagVideoWrap" DockPanel.Dock="Right" Click="BtnToggleTagVideoWrap_Click" Padding="4,2" FontSize="11" Margin="0,0,4,0"
                                    Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"/>
                            <TextBlock x:Name="TxtTagVideoFileListHeader" Text="ファイル一覧" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="14"
                                       FontWeight="Bold"/>
                        </DockPanel>
                        <ListBox x:Name="TagVideoFileListPanel" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource ThemeText}" FontFamily="Yu Gothic UI" FontSize="12"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ItemTemplate="{StaticResource TagListItemTemplateWrap}"
                                 ItemContainerStyle="{StaticResource TagListItemContainerStyle}"
                                 AlternationCount="2"
                                 SelectionChanged="TagVideoFileListPanel_SelectionChanged"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="TxtFileSize" Foreground="{DynamicResource ThemeSubtext}"
                               FontFamily="Yu Gothic UI" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtFileDates" Foreground="{DynamicResource ThemeSubtext}"
                               FontFamily="Yu Gothic UI" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="TxtFileCounter" Foreground="{DynamicResource ThemeSubtext}"
                               FontFamily="Yu Gothic UI" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtSelectionInfo" DockPanel.Dock="Right" Foreground="{DynamicResource ThemeSubtext}"
                           FontFamily="Yu Gothic UI" FontSize="13" VerticalAlignment="Center"/>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStatus" Grid.Column="0" Foreground="{DynamicResource ThemeSubtext}" FontFamily="Yu Gothic UI" FontSize="13"
                               VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="TxtStatus_Click"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BtnSearchWeb" Grid.Column="1" Content="🔍" Click="BtnSearchWeb_Click"
                            ToolTip="DuckDuckGoで検索" Cursor="Hand" FontSize="14"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeSubtext}"
                            Padding="4,0,0,0" Margin="6,0,0,0"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
